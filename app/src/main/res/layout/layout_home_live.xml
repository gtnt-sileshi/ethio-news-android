<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rl_live_tv"
    android:layout_width="@dimen/_120sdp"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/_6sdp"
    android:focusable="true"
    android:focusableInTouchMode="false"
    android:background="@drawable/bg_news_card"
    android:padding="@dimen/_1sdp">

    <!-- Channel thumbnail -->
    <ImageView
        android:id="@+id/iv_live"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_80sdp"
        android:scaleType="centerCrop"
        android:src="@drawable/test_live"
        app:hv_corner_radius_top_left="@dimen/_6sdp"
        app:hv_corner_radius_top_right="@dimen/_6sdp"
        android:layout_margin="@dimen/_3sdp" />

    <!-- LIVE indicator strip -->
    <View
        android:id="@+id/view_live_strip"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_3sdp"
        android:layout_below="@id/iv_live"
        android:layout_marginStart="@dimen/_3sdp"
        android:layout_marginEnd="@dimen/_3sdp"
        android:background="@color/news_live_red"
        android:visibility="gone" />

    <!-- Channel name -->
    <TextView
        android:id="@+id/tv_live"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/view_live_strip"
        android:padding="@dimen/_5sdp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAlignment="center"
        android:text="@string/app_name"
        android:textColor="?ns_title"
        android:textSize="@dimen/_11ssp" />

</RelativeLayout>
