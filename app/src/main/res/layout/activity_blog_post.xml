<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="?ns_bg">

    <!-- Fixed toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:layout_alignParentTop="true"
        android:background="?ns_bg"
        android:elevation="0dp"
        app:navigationIcon="@drawable/ic_arrow_left"
        app:navigationIconTint="?ns_icon_color"
        app:titleTextColor="?ns_title" />

    <!-- Banner ad pinned at bottom -->
    <LinearLayout
        android:id="@+id/ll_adView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="?ns_bg"
        android:orientation="vertical" />

    <!-- Scrollable content between toolbar and ad -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nsv_blog"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/toolbar"
        android:layout_above="@id/ll_adView">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Cover image -->
            <ImageView
                android:id="@+id/iv_blog_cover"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_220sdp"
                android:scaleType="centerCrop"
                android:src="@drawable/material_design_default" />

            <!-- Loading skeleton -->
            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/shimmer_blog_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:shimmer_duration="1000"
                app:shimmer_auto_start="true">

                <include layout="@layout/skeleton_blog_detail" />

            </com.facebook.shimmer.ShimmerFrameLayout>

            <!-- Main content -->
            <LinearLayout
                android:id="@+id/ll_blog_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/_16sdp"
                android:visibility="gone">

                <!-- Category + Read time -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="@dimen/_8sdp">

                    <TextView
                        android:id="@+id/tv_category"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_category_pill"
                        android:paddingStart="@dimen/_10sdp"
                        android:paddingEnd="@dimen/_10sdp"
                        android:paddingTop="@dimen/_3sdp"
                        android:paddingBottom="@dimen/_3sdp"
                        android:text="Category"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_10ssp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tv_read_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3 min read"
                        android:textColor="?ns_title_sub"
                        android:textSize="@dimen/_10ssp" />
                </LinearLayout>

                <!-- Title -->
                <TextView
                    android:id="@+id/tv_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Blog Title"
                    android:textColor="?ns_title"
                    android:textSize="@dimen/_18ssp"
                    android:textStyle="bold"
                    android:layout_marginBottom="@dimen/_8sdp" />

                <!-- Author + Views -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="@dimen/_12sdp">

                    <TextView
                        android:id="@+id/tv_author"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="By Author"
                        android:textColor="?ns_title_sub"
                        android:textSize="@dimen/_11ssp" />

                    <TextView
                        android:id="@+id/tv_views"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 views"
                        android:textColor="?ns_title_sub"
                        android:textSize="@dimen/_11ssp" />
                </LinearLayout>

                <!-- Article HTML content -->
                <android.webkit.WebView
                    android:id="@+id/wv_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <!-- Tags -->
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/cg_tags"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_12sdp"
                    app:chipSpacingHorizontal="@dimen/_4sdp" />

                <!-- Save + Share -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="end"
                    android:layout_marginTop="@dimen/_16sdp"
                    android:layout_marginBottom="@dimen/_16sdp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_save"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/_8sdp"
                        android:text="@string/save"
                        android:textSize="@dimen/_11ssp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_share"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/share"
                        android:textSize="@dimen/_11ssp" />
                </LinearLayout>

                <!-- Comments heading -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/comments"
                    android:textColor="?ns_title"
                    android:textSize="@dimen/_14ssp"
                    android:textStyle="bold"
                    android:layout_marginBottom="@dimen/_8sdp" />

                <!-- Name input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_comment_name"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/your_name"
                    android:layout_marginBottom="@dimen/_6sdp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_comment_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName"
                        android:textSize="@dimen/_12ssp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Comment body -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_comment_body"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/write_comment"
                    android:layout_marginBottom="@dimen/_8sdp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_comment_body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textMultiLine"
                        android:minLines="3"
                        android:textSize="@dimen/_12ssp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_submit_comment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/submit_comment"
                    android:layout_marginBottom="@dimen/_12sdp" />

                <!-- Comments loading -->
                <ProgressBar
                    android:id="@+id/pb_comments"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_comments"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />

                <!-- Related posts -->
                <TextView
                    android:id="@+id/tv_related_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/related_posts"
                    android:textColor="?ns_title"
                    android:textSize="@dimen/_14ssp"
                    android:textStyle="bold"
                    android:layout_marginTop="@dimen/_16sdp"
                    android:layout_marginBottom="@dimen/_8sdp"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_related"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:layout_marginBottom="@dimen/_16sdp" />

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</RelativeLayout>
