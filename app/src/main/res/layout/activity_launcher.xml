<?xml version="1.0" encoding="utf-8"?>
<!--
  Splash screen — always uses the dark-blue hero gradient so text is
  always white-on-blue regardless of the user's light/dark theme choice.
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rl_splash"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash_full"
    android:fitsSystemWindows="true">

    <!-- Decorative circle — top right -->
    <View
        android:layout_width="@dimen/_235sdp"
        android:layout_height="@dimen/_235sdp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="-80dp"
        android:layout_marginEnd="-80dp"
        android:background="@drawable/splash_circle_decoration" />

    <!-- Decorative circle — bottom left -->
    <View
        android:layout_width="@dimen/_160sdp"
        android:layout_height="@dimen/_160sdp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentStart="true"
        android:layout_marginBottom="-50dp"
        android:layout_marginStart="-50dp"
        android:background="@drawable/splash_circle_decoration" />

    <!-- Center content -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical">

        <!-- EN logo -->
        <ImageView
            android:id="@+id/iv_splash_logo"
            android:layout_width="@dimen/_100sdp"
            android:layout_height="@dimen/_100sdp"
            android:src="@drawable/logo"
            android:contentDescription="@string/app_name" />

        <!-- App name — always white, bg is always dark -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_18sdp"
            android:text="@string/app_name"
            android:textColor="@color/white"
            android:textSize="@dimen/_24ssp"
            android:textStyle="bold"
            android:letterSpacing="0.04" />

        <!-- Tagline -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_6sdp"
            android:text="@string/splash_tagline"
            android:textColor="#B3FFFFFF"
            android:textSize="@dimen/_12ssp"
            android:letterSpacing="0.06" />

        <!-- LIVE pill -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_14sdp"
            android:background="@drawable/bg_splash_pill"
            android:paddingStart="@dimen/_16sdp"
            android:paddingEnd="@dimen/_16sdp"
            android:paddingTop="@dimen/_5sdp"
            android:paddingBottom="@dimen/_5sdp"
            android:text="@string/tag_live"
            android:textColor="@color/white"
            android:textSize="@dimen/_10ssp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />

    </LinearLayout>

    <!-- Bottom: spinner + version -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="@dimen/_36sdp"
        android:gravity="center"
        android:orientation="vertical">

        <ProgressBar
            android:id="@+id/pb_splash"
            android:layout_width="@dimen/_28sdp"
            android:layout_height="@dimen/_28sdp"
            android:indeterminateTint="@color/white"
            android:layout_marginBottom="@dimen/_12sdp" />

        <TextView
            android:id="@+id/tv_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="v1.0.0"
            android:textColor="#80FFFFFF"
            android:textSize="@dimen/_11ssp"
            android:letterSpacing="0.05" />

    </LinearLayout>

</RelativeLayout>
