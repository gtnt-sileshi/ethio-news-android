<?xml version="1.0" encoding="utf-8"?>
<!-- Home section header with news masthead styling -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="@dimen/_14sdp"
    android:paddingBottom="@dimen/_4sdp"
    android:orientation="vertical">

    <!-- Header row: accent bar + title + See All -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/_12sdp"
        android:paddingEnd="@dimen/_8sdp">

        <!-- Left accent bar -->
        <View
            android:layout_width="@dimen/_4sdp"
            android:layout_height="@dimen/_20sdp"
            android:background="?ns_primary"
            android:layout_marginEnd="@dimen/_8sdp" />

        <!-- Section title -->
        <TextView
            android:id="@+id/tv_home_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="?ns_title"
            android:textSize="@dimen/_14sdp"
            android:textStyle="bold" />

        <!-- See All -->
        <LinearLayout
            android:id="@+id/ll_home_view_all"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="@dimen/_6sdp"
            android:background="?attr/selectableItemBackground">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="See All"
                android:textColor="?ns_primary"
                android:textSize="@dimen/_12sdp"
                tools:ignore="HardcodedText" />

            <ImageView
                android:layout_width="@dimen/_14sdp"
                android:layout_height="@dimen/_14sdp"
                android:layout_marginStart="@dimen/_2sdp"
                android:src="@drawable/ic_arrow_right"
                android:contentDescription="@string/todo"
                app:tint="?ns_primary" />

        </LinearLayout>

    </LinearLayout>

    <!-- Bottom divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/_1sdp"
        android:layout_marginStart="@dimen/_12sdp"
        android:layout_marginEnd="@dimen/_12sdp"
        android:layout_marginTop="@dimen/_6sdp"
        android:background="?ns_border" />

    <!-- Content RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_home_cat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_8sdp" />

</LinearLayout>
