<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rl_live_tv"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/_4sdp"
    android:focusable="true"
    android:focusableInTouchMode="false"
    android:background="@drawable/bg_news_card"
    android:padding="@dimen/_1sdp">

    <!-- Channel thumbnail -->
    <ImageView
        android:id="@+id/iv_live_tv"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_110sdp"
        android:scaleType="centerCrop"
        android:src="@drawable/material_design_default"
        app:hv_corner_radius_top_left="@dimen/_6sdp"
        app:hv_corner_radius_top_right="@dimen/_6sdp"
        android:layout_margin="@dimen/_3sdp" />

    <!-- LIVE indicator strip -->
    <View
        android:id="@+id/view_live_strip"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_3sdp"
        android:layout_below="@id/iv_live_tv"
        android:layout_marginStart="@dimen/_3sdp"
        android:layout_marginEnd="@dimen/_3sdp"
        android:background="@color/news_live_red"
        android:visibility="gone" />

    <!-- Channel title -->
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/view_live_strip"
        android:lines="1"
        android:padding="@dimen/_6sdp"
        android:text="@string/app_name"
        android:textAlignment="center"
        android:textColor="?ns_title"
        android:textSize="@dimen/_12ssp" />

    <!-- Premium badge -->
    <TextView
        android:id="@+id/tv_live_pre"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_5sdp"
        android:layout_marginTop="@dimen/_5sdp"
        android:background="@drawable/bg_live_tag"
        android:paddingStart="@dimen/_6sdp"
        android:paddingEnd="@dimen/_6sdp"
        android:paddingTop="@dimen/_2sdp"
        android:paddingBottom="@dimen/_2sdp"
        android:text="@string/premium"
        android:textColor="@color/white"
        android:textSize="@dimen/_10ssp"
        android:textStyle="bold" />

</RelativeLayout>
