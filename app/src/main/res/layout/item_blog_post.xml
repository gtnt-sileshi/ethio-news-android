<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ll_blog_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/_8sdp"
    android:layout_marginEnd="@dimen/_8sdp"
    android:layout_marginBottom="@dimen/_10sdp"
    android:background="@drawable/bg_news_card"
    android:orientation="vertical"
    android:clickable="true"
    android:focusable="true">

    <!-- Cover image -->
    <ImageView
        android:id="@+id/iv_blog_cover"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_170sdp"
        android:scaleType="centerCrop"
        android:src="@drawable/material_design_default"
        app:hv_corner_radius_top_left="@dimen/_8sdp"
        app:hv_corner_radius_top_right="@dimen/_8sdp" />

    <!-- Category pill overlaid on image -->
    <TextView
        android:id="@+id/tv_blog_category"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_10sdp"
        android:layout_marginTop="@dimen/_-14sdp"
        android:background="@color/ethio_red"
        android:paddingStart="@dimen/_8sdp"
        android:paddingEnd="@dimen/_8sdp"
        android:paddingTop="@dimen/_3sdp"
        android:paddingBottom="@dimen/_3sdp"
        android:text="Category"
        android:textColor="@color/white"
        android:textSize="@dimen/_9ssp"
        android:textStyle="bold"
        android:elevation="2dp" />

    <!-- Title and metadata -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/_10sdp"
        android:paddingEnd="@dimen/_10sdp"
        android:paddingTop="@dimen/_6sdp"
        android:paddingBottom="@dimen/_10sdp">

        <TextView
            android:id="@+id/tv_blog_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lines="2"
            android:ellipsize="end"
            android:text="Blog Post Title"
            android:textColor="?ns_title"
            android:textSize="@dimen/_13ssp"
            android:textStyle="bold"
            android:layout_marginBottom="@dimen/_4sdp" />

        <TextView
            android:id="@+id/tv_blog_excerpt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lines="2"
            android:ellipsize="end"
            android:text="Excerpt text goes here..."
            android:textColor="?ns_title_sub"
            android:textSize="@dimen/_11ssp"
            android:layout_marginBottom="@dimen/_6sdp" />

        <!-- Meta row: author · date · reading time -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_blog_author"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Author"
                android:textColor="?ns_title_sub"
                android:textSize="@dimen/_10ssp" />

            <TextView
                android:id="@+id/tv_blog_read_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3 min read"
                android:textColor="?ns_primary"
                android:textSize="@dimen/_10ssp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
