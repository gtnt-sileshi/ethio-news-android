<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ── Splash / Launcher theme — always dark blue, no white flash ── -->
    <style name="AppTheme.Launcher" parent="AppTheme">
        <item name="android:windowBackground">@color/ns_classic_primary</item>
        <item name="android:statusBarColor">@color/ns_classic_primary</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
        <item name="android:navigationBarColor">@color/ns_classic_primary</item>
    </style>

    <!-- ── Base app theme (Light / Classic) ──────────────────────────── -->
    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/ns_classic_primary</item>
        <item name="colorPrimaryDark">@color/ethio_red_dark</item>
        <item name="colorAccent">@color/ns_classic_primary</item>
        <!-- Match the window background to the app background so the inset
             padding area (status bar / nav bar) never shows the red primary color. -->
        <item name="android:windowBackground">@color/ns_classic_bg</item>
        <!-- Opt out of the Android 15+ forced edge-to-edge so the app draws
             within the system bars (status bar + nav bar) on all screen edges. -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
        <!-- Ensure the window draws its own system bar backgrounds so the bars
             are visible and content does not bleed underneath them. -->
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/white</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">true</item>
        <item name="android:navigationBarColor">?android:colorBackground</item>
        <!-- colorControlNormal controls toolbar action/overflow icon tints in Material themes -->
        <item name="colorControlNormal">@color/ns_classic_body_dark</item>
        <!-- ns_* colour attributes for Classic (light) mode -->
        <item name="ns_primary">@color/ns_classic_primary</item>
        <item name="ns_primary_sub">@color/ns_classic_primary_sub</item>
        <item name="ns_bg">@color/ns_classic_bg</item>
        <item name="ns_bg_sub">@color/ns_classic_bg_sub</item>
        <item name="ns_bg_dark">@color/ns_classic_body_dark</item>
        <item name="ns_title">@color/ns_classic_title</item>
        <item name="ns_title_sub">@color/ns_classic_title_sub</item>
        <item name="ns_border">@color/ns_classic_border</item>
        <item name="ns_dialog_bg">@color/ns_classic_bg</item>
        <item name="ns_dialog_bg_sub">@color/ns_classic_bg_sub</item>
        <item name="ns_icon_color">@color/ns_classic_title</item>
        <item name="ns_white">@color/white</item>
        <item name="ns_icon_back">@drawable/ic_arrow_left</item>
    </style>

    <!-- ── Dark Grey variant ─────────────────────────────────────────── -->
    <style name="AppTheme.DarkGrey" parent="AppTheme">
        <item name="android:windowBackground">@color/ns_grey_bg</item>
        <item name="android:statusBarColor">@color/ns_grey_bg</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
        <item name="android:navigationBarColor">@color/ns_grey_bg</item>
        <item name="colorControlNormal">@color/ns_white</item>
        <item name="ns_primary">@color/ns_grey_primary</item>
        <item name="ns_primary_sub">@color/ns_grey_primary_sub</item>
        <item name="ns_bg">@color/ns_grey_bg</item>
        <item name="ns_bg_sub">@color/ns_grey_bg_sub</item>
        <item name="ns_bg_dark">@color/ns_white</item>
        <item name="ns_title">@color/ns_grey_title</item>
        <item name="ns_title_sub">@color/ns_grey_title_sub</item>
        <item name="ns_border">@color/ns_grey_border</item>
        <item name="ns_dialog_bg">@color/ns_grey_bg_sub</item>
        <item name="ns_dialog_bg_sub">@color/ns_grey_bg</item>
        <item name="ns_icon_color">@color/ns_grey_title</item>
    </style>

    <!-- ── Dark variant ──────────────────────────────────────────────── -->
    <style name="AppTheme.Dark" parent="AppTheme">
        <item name="android:windowBackground">@color/ns_dark_bg</item>
        <item name="android:statusBarColor">@color/ns_dark_bg</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
        <item name="android:navigationBarColor">@color/ns_dark_bg</item>
        <item name="colorControlNormal">@color/ns_white</item>
        <item name="ns_primary">@color/ns_dark_primary</item>
        <item name="ns_primary_sub">@color/ns_dark_primary_sub</item>
        <item name="ns_bg">@color/ns_dark_bg</item>
        <item name="ns_bg_sub">@color/ns_dark_bg_sub</item>
        <item name="ns_bg_dark">@color/ns_white</item>
        <item name="ns_title">@color/ns_dark_title</item>
        <item name="ns_title_sub">@color/ns_dark_title_sub</item>
        <item name="ns_border">@color/ns_dark_border</item>
        <item name="ns_dialog_bg">@color/ns_dark_bg_sub</item>
        <item name="ns_dialog_bg_sub">@color/ns_dark_bg</item>
        <item name="ns_icon_color">@color/ns_dark_title</item>
    </style>

    <!-- ── Dark Blue variant ─────────────────────────────────────────── -->
    <style name="AppTheme.DarkBlue" parent="AppTheme">
        <item name="android:windowBackground">@color/ns_blue_bg</item>
        <item name="android:statusBarColor">@color/ns_blue_bg</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
        <item name="android:navigationBarColor">@color/ns_blue_bg</item>
        <item name="colorControlNormal">@color/ns_white</item>
        <item name="ns_primary">@color/ns_blue_primary</item>
        <item name="ns_primary_sub">@color/ns_blue_primary_sub</item>
        <item name="ns_bg">@color/ns_blue_bg</item>
        <item name="ns_bg_sub">@color/ns_blue_bg_sub</item>
        <item name="ns_bg_dark">@color/ns_white</item>
        <item name="ns_title">@color/ns_blue_title</item>
        <item name="ns_title_sub">@color/ns_blue_title_sub</item>
        <item name="ns_border">@color/ns_blue_border</item>
        <item name="ns_dialog_bg">@color/ns_blue_bg_sub</item>
        <item name="ns_dialog_bg_sub">@color/ns_blue_bg</item>
        <item name="ns_icon_color">@color/ns_blue_title</item>
    </style>

    <!-- ── Dialog theme ──────────────────────────────────────────────── -->
    <style name="dialogTheme" parent="Theme.MaterialComponents.DayNight.Dialog.Alert">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="buttonBarNegativeButtonStyle">@style/ButtonStyle</item>
        <item name="buttonBarPositiveButtonStyle">@style/ButtonStyle</item>
    </style>

    <style name="ButtonStyle" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">@color/ns_classic_primary</item>
    </style>

    <style name="dialogAnimation">
        <item name="android:windowEnterAnimation">@anim/slide_up_dialog</item>
        <item name="android:windowExitAnimation">@anim/slide_down_dialog</item>
    </style>

    <style name="ratingBarWhite" parent="Widget.AppCompat.RatingBar.Small">
        <item name="colorControlNormal">@color/ns_classic_title_sub</item>
        <item name="colorControlActivated">@color/ns_classic_primary</item>
    </style>

    <style name="ratingBarDialog" parent="Theme.AppCompat">
        <item name="colorControlNormal">@color/ns_classic_title_sub</item>
        <item name="colorControlActivated">#FF9800</item>
    </style>

    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar">
        <item name="colorAccent">@color/ns_white</item>
    </style>

    <style name="TextViewNormal" parent="">
        <item name="android:textSize">14sp</item>
    </style>

    <style name="PopupMenuLight" parent="ThemeOverlay.AppCompat.Light" />
    <style name="PopupMenuDark"  parent="ThemeOverlay.AppCompat.Dark" />

    <style name="CircularProgressWhite" parent="Theme.AppCompat.Light">
        <item name="colorAccent">@color/ns_white</item>
    </style>

    <style name="Theme.CastVideosDark" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimaryDark">@android:color/black</item>
        <item name="castMiniControllerStyle">@style/CustomCastMiniController</item>
        <item name="castIntroOverlayStyle">@style/CustomCastIntroOverlay</item>
        <item name="castExpandedControllerStyle">@style/CustomCastExpandedController</item>
        <item name="castExpandedControllerToolbarStyle">@style/ThemeOverlay.AppCompat.Dark.ActionBar</item>
    </style>

    <style name="CustomCastIntroOverlay" parent="CastIntroOverlay">
        <item name="castButtonTextAppearance">@style/TextAppearance.CustomCastIntroOverlay.Button</item>
        <item name="castTitleTextAppearance">@style/TextAppearance.CustomCastIntroOverlay.Title</item>
    </style>

    <style name="TextAppearance.CustomCastIntroOverlay.Button" parent="android:style/TextAppearance">
        <item name="android:textColor">@android:color/white</item>
    </style>

    <style name="TextAppearance.CustomCastIntroOverlay.Title" parent="android:style/TextAppearance.Large">
        <item name="android:textColor">@android:color/white</item>
    </style>

    <style name="CustomCastMiniController" parent="CastMiniController">
        <item name="castShowImageThumbnail">true</item>
        <item name="castTitleTextAppearance">@style/TextAppearance.AppCompat.Subhead</item>
        <item name="castSubtitleTextAppearance">@style/TextAppearance.AppCompat.Caption</item>
    </style>

    <style name="CustomCastExpandedController" parent="CastExpandedController" />

</resources>
