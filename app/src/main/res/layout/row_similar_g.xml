<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rl_home_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/_5sdp"
    android:background="@drawable/bg_news_card_selector">

    <ImageView
        android:id="@+id/iv_similar_img"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_100sdp"
        android:scaleType="centerCrop"
        android:src="@drawable/material_design_default"
        app:hv_corner_radius_top_left="@dimen/_8sdp"
        app:hv_corner_radius_top_right="@dimen/_8sdp" />

    <!-- Left accent strip -->
    <View
        android:layout_width="@dimen/_3sdp"
        android:layout_height="match_parent"
        android:layout_below="@id/iv_similar_img"
        android:background="?ns_primary" />

    <TextView
        android:id="@+id/tv_similar_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/iv_similar_img"
        android:lines="1"
        android:ellipsize="end"
        android:paddingStart="@dimen/_10sdp"
        android:paddingEnd="@dimen/_8sdp"
        android:paddingTop="@dimen/_6sdp"
        android:paddingBottom="@dimen/_6sdp"
        android:text="@string/app_name"
        android:textColor="?ns_title"
        android:textSize="@dimen/_12ssp"
        android:textStyle="bold" />

</RelativeLayout>
