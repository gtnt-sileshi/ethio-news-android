<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Neutral grey — visually distinct from btn_primary (red) so
         Cancel actions don't look the same as primary actions.           -->
    <gradient
        android:angle="135"
        android:startColor="#6B7280"
        android:endColor="#4B5563"
        android:type="linear"/>

    <corners android:radius="@dimen/_5sdp"/>

    <stroke
        android:width="@dimen/_1sdp"
        android:color="?ns_border" />

</shape>
