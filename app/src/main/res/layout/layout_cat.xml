<?xml version="1.0" encoding="utf-8"?>
<!-- News topic/category card — image with an overlay label strip -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rl_live_tv"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/_4sdp"
    android:focusable="true"
    android:focusableInTouchMode="false"
    android:background="@drawable/bg_news_card_selector">

    <!-- Category cover image -->
    <ImageView
        android:id="@+id/iv_live_tv"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_100sdp"
        android:scaleType="centerCrop"
        android:src="@drawable/material_design_default"
        app:hv_corner_radius_top_left="@dimen/_8sdp"
        app:hv_corner_radius_top_right="@dimen/_8sdp" />

    <!-- Dark overlay at bottom of image -->
    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/_40sdp"
        android:layout_alignBottom="@id/iv_live_tv"
        android:background="@drawable/bg_banner_scrim" />

    <!-- Left-aligned primary accent strip -->
    <View
        android:layout_width="@dimen/_3sdp"
        android:layout_height="match_parent"
        android:layout_below="@id/iv_live_tv"
        android:background="?ns_primary" />

    <!-- Category name -->
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/iv_live_tv"
        android:paddingStart="@dimen/_10sdp"
        android:paddingEnd="@dimen/_8sdp"
        android:paddingTop="@dimen/_7sdp"
        android:paddingBottom="@dimen/_7sdp"
        android:lines="1"
        android:ellipsize="end"
        android:text="@string/app_name"
        android:textColor="?ns_title"
        android:textSize="@dimen/_12ssp"
        android:textStyle="bold" />

</RelativeLayout>
